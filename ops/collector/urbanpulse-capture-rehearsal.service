[Unit]
Description=Finite offline UrbanPulse collector host rehearsal
BindsTo=srv-urbanpulse.mount docker.service
After=srv-urbanpulse.mount docker.service
AssertPathIsMountPoint=/srv/urbanpulse

[Service]
Type=exec
User=root
UMask=0077
LimitCORE=0
ExecStart=/usr/bin/python3 /usr/local/lib/urbanpulse/collector_host.py run
ExecStop=-/usr/bin/docker stop --time 30 urbanpulse-capture-rehearsal
TimeoutStopSec=45s
Restart=no
