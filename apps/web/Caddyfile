{
	admin off
	auto_https off
	persist_config off
}

# Apply at response write time, including responses from the backend.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The edge terminates TLS. Browsers ignore HSTS on local HTTP responses.
		Strict-Transport-Security "max-age=31536000"
		-Server
		defer
	}
}

:{$PORT:8080} {
	root * /srv
	encode gzip
	import security_headers

	@backend path /api /api/* /health /health/*
	handle @backend {
		header Cache-Control "no-store"
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8000} {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# Reserved build/source paths must not fall back to a successful SPA response.
	@private path /.env* /.git/* /src/* /@vite/* /@id/* /node_modules/* /Caddyfile /package*.json
	handle @private {
		respond 404
	}

	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Error routes have their own response chain; repeat the shared policy here.
	handle_errors {
		import security_headers
		header >Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
