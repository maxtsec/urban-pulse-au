{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode gzip
	header X-Content-Type-Options nosniff
	header -Server

	@backend path /api /api/* /health /health/*
	handle @backend {
		header Cache-Control "no-store"
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8000} {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# Reserved build/source paths must not fall back to a successful SPA response.
	@private path /.env* /.git/* /src/* /@vite/* /@id/* /node_modules/* /Caddyfile /package*.json
	handle @private {
		respond 404
	}

	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
